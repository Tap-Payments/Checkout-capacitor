{
  "name": "checkout-capacitor-example",
  "version": "1.0.0",
  "private": true,
  "description": "Example app for checkout-capacitor",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap run ios",
    "android": "npm run sync && cap run android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "checkout-capacitor": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "license": "MIT"
}
